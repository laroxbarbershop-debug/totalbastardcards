{
  "name": "cctt",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cctt-db",
      "database_id": "8e7fe727-f75f-47e9-b7de-6fe121c6c1ac"
    }
  ],
  "routes": [{ "pattern": "totalbastardcards.com", "custom_domain": true }],
  "workers_dev": true
}
